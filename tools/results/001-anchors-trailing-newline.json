{
  "measurement": "001-anchors-trailing-newline",
  "env": {
    "os": {
      "system": "Darwin",
      "release": "25.5.0",
      "machine": "arm64"
    },
    "cpu": "arm",
    "runtimes": {
      "python": "3.14.5",
      "node": "v24.18.0",
      "go": "go version go1.26.5 darwin/arm64",
      "rustc": "rustc 1.97.1 (8bab26f4f 2026-07-14) (Homebrew)",
      "dotnet": "10.0.302",
      "grep": "grep (BSD grep, GNU compatible) 2.6.0-FreeBSD",
      "sed": "/usr/bin/sed: illegal option -- -",
      "pcre2grep": "pcre2grep version 10.47 2025-10-21"
    }
  },
  "python": {
    "version": "3.14.5",
    "rows": [
      {
        "pattern": "^ABC$",
        "results": {
          "trailing_lf": true,
          "inner_lf": false
        }
      },
      {
        "pattern": "^ABC\\Z",
        "results": {
          "trailing_lf": false,
          "inner_lf": false
        }
      },
      {
        "pattern": "\\AABC\\Z",
        "results": {
          "trailing_lf": false,
          "inner_lf": false
        }
      }
    ]
  },
  "javascript": {
    "version": "v24.18.0",
    "pattern": "/^ABC$/",
    "results": {
      "trailing_lf": false,
      "inner_lf": false
    }
  }
}
