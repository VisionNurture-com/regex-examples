{
  "measurement": "001-anchors-trailing-newline",
  "env": {
    "os": {
      "system": "Darwin",
      "release": "25.6.0",
      "machine": "arm64"
    },
    "cpu": "arm",
    "runtimes": {
      "python": "3.14.7",
      "node": "v24.19.0",
      "go": "go version go1.27.1 darwin/arm64",
      "rustc": "rustc 1.98.1 (48a229cea 2026-09-01) (Homebrew)",
      "dotnet": "10.0.400",
      "perl": "v5.34.1",
      "ruby": "ruby 3.4.10 (2026-06-30 revision 2b0b7728dc) +PRISM [arm64-darwin25]",
      "grep": "grep (BSD grep, GNU compatible) 2.6.0-FreeBSD",
      "sed": "/usr/bin/sed: illegal option -- -",
      "pcre2grep": "pcre2grep version 10.48 2026-08-31"
    }
  },
  "python": {
    "version": "3.14.7",
    "rows": [
      {
        "pattern": "^ABC$",
        "results": {
          "trailing_lf": true,
          "inner_lf": false
        }
      },
      {
        "pattern": "^ABC\\Z",
        "results": {
          "trailing_lf": false,
          "inner_lf": false
        }
      },
      {
        "pattern": "\\AABC\\Z",
        "results": {
          "trailing_lf": false,
          "inner_lf": false
        }
      }
    ]
  },
  "javascript": {
    "version": "v24.19.0",
    "pattern": "/^ABC$/",
    "results": {
      "trailing_lf": false,
      "inner_lf": false
    }
  }
}
